#Sampling methods

library(rgbif)
library(dplyr)

names(dataset)
dataset_sm <- dataset %>% filter(matchContour == "matchDeep") 

datasetProtocols <- c()
for(i in 1:nrow(dataset_sm)){
  x <- matchDeep[i,]
dataset_key <- x$dataset
target_date <- x$eventDate
if(is.na(target_date)) {
  target_date = 0} 
if(grepl(".{10,}", target_date)) {
  target_date = str_extract(target_date, "^.{10}")}
if(grepl(".{9}", target_date)) {
  target_date = str_extract(target_date, "^.{4}")}
if(grepl("--", target_date)) {
  target_date = str_extract(target_date, "^.{4}")}


if (!is.na(dataset_key)){
prot <- occ_data(
  datasetKey = dataset_key,
  eventDate = target_date,
  limit = 100 
)}

if (!is.null(prot$data)) {
  sampling_info <- prot$data %>%
    dplyr::select(any_of(c("samplingProtocol", "protocol", "samplingEffort", "sampleSizeValue", "sampleSizeUnit", "samplingDescription","eventRemarks")))
  print(sampling_info)
  print(str(prot))
  sampling_info <- as.data.frame(sampling_info)
  sampling_info <- unique(sampling_info[[1]])
}

if(i == 1){
  datasetProtocols <- sampling_info
} else {
  datasetProtocols <- c(sampling_info, datasetProtocols)
}

}

